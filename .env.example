# --- TMDB ----------------------------------------------------------------
# Get a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# --- Supabase (auth + DB) -----------------------------------------------
# Free tier: https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- h5-api upstream (the source of truth for content metadata) --------
# Bearer auth is minted in the Next.js process. Override only if you
# know what you're doing.
H5_API_BASE=https://h5-api.aoneroom.com/wefeed-h5api-bff

# --- OnStream (aoneroom mobile BFF) ---------------------------------------
# The OnStream backend signs every gateway request with an HMAC-MD5 over a
# canonical request, so a key is required to use it at all. This is a
# CLIENT-side key: the original OnStream app ships it inside its own
# resolver asset, so it grants nothing that downloading the app does not.
# It is still kept out of source control, and it is a server-only value —
# never prefix it with NEXT_PUBLIC_.
#
# With this set, /api/sources resolves the episode straight from OnStream
# (session bootstrap -> resolution sweep -> sniff/config) and returns a raw
# signed media URL on bcdn.hakunaymatata.com, which the player streams
# through our own /api/video-proxy. The thin relay is then only the
# fallback. Without it, the relay handles everything.
ONSTREAM_GATEWAY_SECRET_B64=

# Public client-build constants of the shipped resolver. They have working
# defaults; override only if the network reissues the client build.
# ONSTREAM_CLIENT_BUILD_CERT_SHA256=
# ONSTREAM_CLIENT_BUILD_SALT=

# --- Thin stream relay (also used by the Android app) -----------------
# The Next.js app calls this for /stream (source list + captions) AND for
# the media itself: /api/sources hands the player URLs that point at the
# relay's /mp4 and /subtitle endpoints, so Vercel never carries a video
# byte. Home / search / browse / detail / anime go directly through
# h5-api. Same relay the Android app uses, so behaviour is identical.
#
# This is now the FALLBACK path: it is only used when the OnStream path is
# unavailable or the subject has no OnStream resource.
STREAM_RELAY_URL=https://p01--movbox-api--d6kx854d4rvy.code.run

# --- Site ----------------------------------------------------------------
# Used for canonical URLs in sitemap + metadata
NEXT_PUBLIC_SITE_URL=https://hmovies.xyz
