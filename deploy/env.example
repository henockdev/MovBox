# ---------------------------------------------------------------------------
# Runtime environment for the self-hosted Movbox app.
#
# Copy to the repo root as `.env` ON THE SERVER (never commit it):
#
#   cp deploy/env.example .env
#
# NEXT_PUBLIC_* values are baked into the client bundle at BUILD time, so
# changing them needs a rebuild (./deploy/deploy.sh), not just a restart.
# ---------------------------------------------------------------------------

# The public origin. Used for canonical URLs, og:url and the sitemap.
NEXT_PUBLIC_SITE_URL=https://movbox.xyz

# Ad kill switch. "false" or "0" turns every ad unit off. Read at BUILD time.
NEXT_PUBLIC_ADS_ENABLED=true

# OnStream gateway secret (base64). Optional: without it the app falls back
# to the thin relay, which is what it does when the upstream is unavailable.
# The value lives in the developer's local .env.local — it is a secret and is
# never committed.
# ONSTREAM_GATEWAY_SECRET_B64=
